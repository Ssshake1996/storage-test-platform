+  const environment = await state.saveEnvironment({ host: "10.0.0.1", username: "root", name: "存储" });
+  const remote = fakeRemoteSession();
+  const writes = [];
+  const signals = [];
+  remote.signal = async (signal) => {
+    signals.push(signal);
+    remote.outputBuffer.append("\nadmin:/>");
+    return { delivered: true, targetPgid: 1 };
+  };
+  state.sessions.set("pty-cli", { sessionId: "pty-cli", ownerId: owner.id, owner, environment, session: remote });
+  ctx.terminals.startSend = (_owner, id, request) => {
+    assert.equal(id, "pty-cli");
+    writes.push(request);
+    if (request.text === "delete lun") remote.outputBuffer.append("WARNING\nHave you read warning message carefully?(y/n)");
+    else if (request.text === "y\n") remote.outputBuffer.append("\nSuccess\nadmin:/>");
+    else remote.outputBuffer.append([
+      "admin:/>show host_group general host_id=3",
+      "                                     ^",
+      "[host_group_id=?]           [host_group_name=?]",
+    ].join("\n"));
+    return { done: Promise.resolve({ waitReason: "inferred_idle", sessionStatus: remote.status() }) };
+  };
+  const confirmed = await state.send(owner, "pty-cli", { text: "delete lun", autoConfirm: true });
+  assert.equal(confirmed.autoConfirmed, 1);
+  assert.equal(writes[1].text, "y\n");
+  assert.equal(writes[1].submit, false);
+  assert.match(confirmed.output, /Success/);
+  const polluted = await state.send(owner, "pty-cli", { text: "show host_group general host_id=3" });
+  assert.deepEqual(signals, ["SIGINT"]);
+  assert.equal(polluted.autoSigint, true);
+  assert.match(polluted.output, /\[auto-sigint: command line cleared\]$/);
+  assert.equal(remote.outputBuffer.value.includes(AUTO_SIGINT_MARKER), false);
+});
