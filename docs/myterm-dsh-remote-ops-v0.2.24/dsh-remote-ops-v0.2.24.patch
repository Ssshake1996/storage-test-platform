+    else if (text === "y\n") terminal.output.emit("data", Buffer.from("\nSuccess\nadmin:/>"));
+    else terminal.output.emit("data", Buffer.from("WARNING: You are about to delete\n--More--(Quit : q|Q)(Next Record : Enter)(Next Page : Space)(To End : G)"));
+  };
+  const result = await state.send({ id: "agent" }, "local-cmd", {
