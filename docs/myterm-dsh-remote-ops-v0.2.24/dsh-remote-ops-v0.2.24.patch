+test("autoConfirm answers trailing y/n prompts in one send and stops at three", async (t) => {
+  const { state, terminal } = await terminalFixture(t);
+  let replies = 0;
+  terminal.write = async (text) => {
+    terminal.writes.push(text);
+    if (text === "y\n") replies += 1;
+    const payload = text === "y\n" && replies >= 2
+      ? "\nCommand executed successfully.\r\nadmin:/>"
+      : "\nAre you sure you really want to perform the operation?(y/n) ";
+    terminal.output.emit("data", Buffer.from(payload));
+  };
+  const result = await state.send({ id: "agent" }, "local-cmd", { text: "delete host", autoConfirm: true, quietMs: 20, timeoutSeconds: 2 });
+  assert.deepEqual(terminal.writes, ["delete host\r", "y\n", "y\n"]);
+  assert.equal(result.autoConfirmed, 2);
+  assert.equal(result.autoMoreQuit, false);
+  assert.equal(result.autoSigint, false);
+  assert.match(result.output, /Command executed successfully/);
+  assert.equal(outputNeedsConfirm(result.output, null), false);
+
+  terminal.writes.length = 0;
+  replies = 0;
+  terminal.write = async (text) => {
+    terminal.writes.push(text);
+    terminal.output.emit("data", Buffer.from("\nHave you read warning message carefully?(y/n)"));
+  };
+  const limited = await state.send({ id: "agent" }, "local-cmd", { text: "delete host", autoConfirm: true, confirmPattern: "\\(y\\/n\\)\\s*$", quietMs: 20, timeoutSeconds: 2 });
+  assert.equal(limited.autoConfirmed, 3);
+  assert.deepEqual(terminal.writes, ["delete host\r", "y\n", "y\n", "y\n"]);
+  assert.match(limited.output, /\(y\/n\)$/);
+
+  terminal.writes.length = 0;
+  const ignored = await state.send({ id: "agent" }, "local-cmd", { text: "delete host", quietMs: 20, timeoutSeconds: 1 });
+  assert.deepEqual(terminal.writes, ["delete host\r"]);
+  assert.equal(ignored.autoConfirmed, 0);
+  assert.match(ignored.output, /\(y\/n\)$/);
+  await assert.rejects(
+    state.send({ id: "agent" }, "local-cmd", { text: "delete host", autoConfirm: true, confirmPattern: "(" }),
+    { code: "CONFIRM_PATTERN_INVALID" },
+  );
+  assert.deepEqual(terminal.writes, ["delete host\r"]);
+});
